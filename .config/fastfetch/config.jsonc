        {
        "type":"separator",
        "string":"┌───────────────────────────────────────────────────────────┐",
        "times": 1,
        "outputColor": "38;2;193;28;132"
    },
    {
    "type":"wm",
    "key":"|Wm",
    },
    //"font",
    {
        "type":"cursor",
        "key":"|Cursor"
    },
    //"host",
    {
        "type":"separator",
        "string":"└───────────────────────────────────────────────────────────┘",
        "times": 1,
        "outputColor": "38;2;193;28;132"
    },
    //"terminalfont",
    {
        "type":"separator",
        "string":"┌───────────────────────────────────────────────────────────┐",
        "times": 1,
        "outputColor": "38;2;193;28;132"
    },
    {
        "type":"cpu",
        "key":"|Cpu"
    },
    {
        "type":"gpu",
        "key":"|Gpu",
    },
    {
     "type":"memory",
     "key":"|Memory",
     "percent":{
         "type": 3,
         "green": 30,
	 "yellow": 70
     }

    
    },
    {
    "type":"swap",
    "key":"|Swap",
    },
    {
    "type":"disk",
    "key":"|Disk"
    },
    {
        "type":"separator",
        "string":"└───────────────────────────────────────────────────────────┘",
        "times": 1,
        "outputColor": "38;2;193;28;132"
    },

